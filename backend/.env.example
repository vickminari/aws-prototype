# Copie para backend/.env e ajuste. O .env NUNCA é commitado (ARQ §5.8).
# Em produção o .env fica na raiz do repositório (lido pelo docker-compose.prod.yml), gerado na
# EC2 por infra/ec2/load-env.sh a partir do Parameter Store. ENVIRONMENT=prod é fixado no compose.

# dev | test | prod
ENVIRONMENT=dev

# Banco local do docker-compose (credenciais só de desenvolvimento).
# Rodando a API fora do Docker use localhost; dentro do compose o host é "db" (já definido lá).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Em prod: mínimo de 32 caracteres aleatórios, vindo do Parameter Store.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-me
JWT_EXPIRE_MINUTES=60

# Segredo separado do JWT; gere outro valor aleatório para produção (SSM SecureString).
# Omitido em dev/test usa o padrão local; o padrão é rejeitado em produção.
# CSRF_SECRET=<valor-aleatorio-exclusivo-com-ao-menos-32-caracteres>
# Origens completas (esquema + host + porta opcional), separadas por vírgula.
# Em dev, se omitida, aceita o frontend local (os mesmos valores abaixo).
# Em produção: lista explícita HTTPS, mesmo com CORS_ORIGINS vazio.
# Produção (#23): CSRF_TRUSTED_ORIGINS=https://52-15-241-143.sslip.io
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_EXPIRE_MINUTES=60

# local | s3 (s3 exige S3_BUCKET)
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=us-east-2

# Origens permitidas, separadas por vírgula. Em produção fica vazio (mesma origem via Nginx).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG

# --- Sprint 2 (ARQ §5.8) ---
# Cota por usuário e limite por arquivo, em bytes (100 MB). Só o original conta na cota.
USER_QUOTA_BYTES=104857600
MAX_UPLOAD_BYTES=104857600
# Validade do POST pré-assinado do upload, em segundos
UPLOAD_URL_EXPIRE_SECONDS=900
# Upload não concluído depois deste tempo é liberado (objeto apagado e cota devolvida)
PENDING_UPLOAD_TTL_MINUTES=60

# memory (testes e dev sem fila) | sqs (compose de dev com ElasticMQ e produção; exige SQS_QUEUE_URL)
QUEUE_BACKEND=memory
# Compose de dev: SQS_QUEUE_URL=http://elasticmq:9324/000000000000/proto2-media-jobs
# SQS_QUEUE_URL=
# Só no dev, para o boto3 falar com o ElasticMQ (ex.: http://elasticmq:9324). Em produção fica vazio.
# AWS_ENDPOINT_URL=

# 1 = aplica as migrações ao subir (API); 0 = não aplica (worker)
RUN_MIGRATIONS=1
# Pool de conexões por processo; com várias instâncias a soma precisa caber no RDS
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Vídeos mais longos que isso falham com VIDEO_TOO_LONG
VIDEO_MAX_DURATION_SECONDS=600

# Só em produção (#23), lido pelo infra/ec2/deploy.sh e não pela API: domínio do
# certificado HTTPS do Let's Encrypt. sslip.io aponta o nome para o Elastic IP da EC2.
# PUBLIC_HOST=52-15-241-143.sslip.io
