# Copie para backend/.env e ajuste. O .env NUNCA é commitado (ARQ §5.8).
# Em produção o .env fica na raiz do repositório (lido pelo docker-compose.prod.yml), gerado na
# EC2 por infra/ec2/load-env.sh a partir do Parameter Store. ENVIRONMENT=prod é fixado no compose.

# dev | test | prod
ENVIRONMENT=dev

# Banco local do docker-compose (credenciais só de desenvolvimento).
# Rodando a API fora do Docker use localhost; dentro do compose o host é "db" (já definido lá).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Em prod: mínimo de 32 caracteres aleatórios, vindo do Parameter Store.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-me
JWT_EXPIRE_MINUTES=60

# Segredo separado do JWT; gere outro valor aleatório para produção (SSM SecureString).
# Omitido em dev/test usa o padrão local; o padrão é rejeitado em produção.
# CSRF_SECRET=<valor-aleatorio-exclusivo-com-ao-menos-32-caracteres>
# Origens completas (esquema + host + porta opcional), separadas por vírgula.
# Em dev, se omitida, aceita o frontend local (os mesmos valores abaixo).
# Em produção: lista explícita HTTPS, mesmo com CORS_ORIGINS vazio.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_EXPIRE_MINUTES=60

# local | s3 (s3 exige S3_BUCKET)
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=us-east-2

# Origens permitidas, separadas por vírgula. Em produção fica vazio (mesma origem via Nginx).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG
