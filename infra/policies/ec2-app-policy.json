{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AvatarsNoBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::proto1-avatars-SUFIXO/avatars/*"
    },
    {
      "Sid": "LerSegredosDaAplicacao",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/proto1/*"
    }
  ]
}
